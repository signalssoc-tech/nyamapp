{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    },
    {
      "source": "/supabase-config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
